 #define STRIDE 64
 #define MIN_WIDTH 1
 
+#if defined(__arm__) && defined(__ARM_NEON)
+static void dispatch_c_marker(void) {}
+static void dispatch_neon_marker(void) {}
+
+static void check_armv7_neon_dispatch(const BitmapEngine *engine,
+                                      unsigned cpu_flag)
+{
+    Convert16to8Func ass_stripe_pack16_c;
+    FilterFunc ass_shrink_horz16_c, ass_shrink_vert16_c;
+    FilterFunc ass_expand_horz16_c, ass_expand_vert16_c;
+    void *marker = cpu_flag & ASS_CPU_FLAG_ARM_NEON ?
+        dispatch_neon_marker : dispatch_c_marker;
+
+    if (checkasm_check_func(marker, "armv7_neon_gaussian_dispatch") &&
+        cpu_flag & ASS_CPU_FLAG_ARM_NEON &&
+        (engine->stripe_pack == ass_stripe_pack16_c ||
+         engine->shrink_horz == ass_shrink_horz16_c ||
+         engine->shrink_vert == ass_shrink_vert16_c ||
+         engine->expand_horz == ass_expand_horz16_c ||
+         engine->expand_vert == ass_expand_vert16_c))
+        fail();
+    report("armv7_neon_gaussian_dispatch");
+}
+#endif
+
 static void check_stripe_unpack(Convert8to16Func func, const char *name, int align)
 {
     ALIGN(uint8_t src[STRIDE * HEIGHT], 32);
@@ -181,6 +206,9 @@ void checkasm_check_blur(unsigned cpu_flag)
         ass_bitmap_engine_init(cpu_flag),
         ass_bitmap_engine_init(cpu_flag | ASS_FLAG_WIDE_STRIPE)
     };
+#if defined(__arm__) && defined(__ARM_NEON)
+    check_armv7_neon_dispatch(&engine[0], cpu_flag);
+#endif
     for (int i = 0; i < 2; i++) {
         int align = 1 << engine[i].align_order;
         check_stripe_unpack(engine[i].stripe_unpack, "stripe_unpack%d", align);
