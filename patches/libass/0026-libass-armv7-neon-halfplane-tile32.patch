+static inline uint8x8_t fill_halfplane_line32_neon(int16x8_t x,
+                                                    int16_t aa,
+                                                    int16_t cc,
+                                                    int16_t delta)
+{
+    int16x8_t distance = vsubq_s16(vdupq_n_s16(cc), vmulq_n_s16(x, aa));
+    int16x8_t c1 = vaddq_s16(distance, vdupq_n_s16(delta));
+    int16x8_t c2 = vsubq_s16(distance, vdupq_n_s16(delta));
+    int16x8_t zero = vdupq_n_s16(0);
+    int16x8_t full = vdupq_n_s16(FULL_VALUE_32);
+    c1 = vminq_s16(vmaxq_s16(c1, zero), full);
+    c2 = vminq_s16(vmaxq_s16(c2, zero), full);
+    return vqmovun_s16(vshrq_n_s16(vaddq_s16(c1, c2), 2));
+}
+
+void ass_fill_halfplane_tile32_neon(uint8_t *buf, ptrdiff_t stride,
+                                     int32_t a, int32_t b,
+                                     int64_t c, int32_t scale)
+{
+    ASSUME(!((uintptr_t) buf % ALIGNMENT) && !(stride % ALIGNMENT));
+
+    int16_t aa = RESCALE_AB_32(a, scale), bb = RESCALE_AB_32(b, scale);
+    int16_t cc = RESCALE_C_32(c, scale) + FULL_VALUE_32 / 2 -
+                 ((aa + bb) >> 1);
+    int16_t abs_a = aa < 0 ? -aa : aa;
+    int16_t abs_b = bb < 0 ? -bb : bb;
+    int16_t delta = (FFMIN(abs_a, abs_b) + 2) >> 2;
+
+    static const int16_t indices[8] = { 0, 1, 2, 3, 4, 5, 6, 7 };
+    int16x8_t step = vdupq_n_s16(8);
+    int16x8_t x0 = vld1q_s16(indices);
+    int16x8_t x1 = vaddq_s16(x0, step);
+    int16x8_t x2 = vaddq_s16(x1, step);
+    int16x8_t x3 = vaddq_s16(x2, step);
+
+    for (int y = 0; y < 32; y++) {
+        vst1_u8(buf, fill_halfplane_line32_neon(x0, aa, cc, delta));
+        vst1_u8(buf + 8, fill_halfplane_line32_neon(x1, aa, cc, delta));
+        vst1_u8(buf + 16, fill_halfplane_line32_neon(x2, aa, cc, delta));
+        vst1_u8(buf + 24, fill_halfplane_line32_neon(x3, aa, cc, delta));
+        buf += stride;
+        cc -= bb;
+    }
+}
