+void ass_fill_solid_tile32_neon(uint8_t *buf, ptrdiff_t stride, int set)
+{
+    ASSUME(!((uintptr_t) buf % ALIGNMENT) && !(stride % ALIGNMENT));
+
+    uint8x16_t value = vdupq_n_u8(set ? 255 : 0);
+    for (int y = 0; y < 32; y++) {
+        vst1q_u8(buf, value);
+        vst1q_u8(buf + 16, value);
+        buf += stride;
+    }
+}
