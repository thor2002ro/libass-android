diff --git a/libass/c/c_blend_bitmaps_neon.c b/libass/c/c_blend_bitmaps_neon.c
new file mode 100644
index 0000000000000000000000000000000000000000..84314c5164009a72cf0aeac6bd54a3a28ca0f8f9
--- /dev/null
+++ b/libass/c/c_blend_bitmaps_neon.c
@@ -0,0 +1,53 @@
+#include "config.h"
+
+#if defined(__arm__) && defined(__ARM_NEON)
+
+#include "ass_compat.h"
+#include "ass_utils.h"
+
+#include <arm_neon.h>
+#include <stddef.h>
+#include <stdint.h>
+
+
+#define ALIGNMENT  16
+#define BLOCK_SIZE 16
+
+
+void ass_add_bitmaps_neon(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                          const uint8_t *restrict src, ptrdiff_t src_stride,
+                          size_t width, size_t height)
+{
+    ASSUME(!(dst_stride % ALIGNMENT));
+    ASSUME(!(src_stride % ALIGNMENT));
+    ASSUME(width > 0 && height > 0);
+
+    // A separate vector boundary lets the compiler prove that the scalar
+    // tail is shorter than one block and prevents redundant vectorization.
+    const size_t tail_width = width & (BLOCK_SIZE - 1);
+    const size_t full_width = width - tail_width;
+    for (size_t y = 0; y < height; y++) {
+        size_t x = 0;
+
+        // Saturating byte addition maps the bitmap blend directly to one
+        // NEON instruction without the C path's widening and narrowing.
+        for (; x < full_width; x += BLOCK_SIZE) {
+            uint8x16_t value = vqaddq_u8(vld1q_u8(dst + x),
+                                         vld1q_u8(src + x));
+            vst1q_u8(dst + x, value);
+        }
+        for (size_t i = 0; i < tail_width; i++, x++) {
+            unsigned value = dst[x] + src[x];
+            dst[x] = value > 255 ? 255 : value;
+        }
+
+        dst += dst_stride;
+        src += src_stride;
+    }
+}
+
+
+#undef ALIGNMENT
+#undef BLOCK_SIZE
+
+#endif
