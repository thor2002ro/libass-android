diff --git a/libass/c/c_blur_neon.c b/libass/c/c_blur_neon.c
index 4b1552d643d981403e9621b6d544f78d90f1880b..3a4e1f623b60bcd7919f660f5eb645580f06dbdb 100644
--- a/libass/c/c_blur_neon.c
+++ b/libass/c/c_blur_neon.c
@@ -426,9 +426,206 @@ void ass_expand_vert16_neon(int16_t *restrict dst,
     }
 }
 
+static inline int16x8_t finish_param_blur(int16x8_t center,
+                                          int32x4_t lo, int32x4_t hi)
+{
+    int16x8_t correction = vcombine_s16(vshrn_n_s32(lo, 16),
+                                         vshrn_n_s32(hi, 16));
+    return vaddq_s16(center, correction);
+}
+
+static inline void accumulate_param_pair(int32x4_t *lo, int32x4_t *hi,
+                                         int16x8_t center,
+                                         int16x8_t first, int16x8_t second,
+                                         int16_t weight)
+{
+    first = vsubq_s16(first, center);
+    second = vsubq_s16(second, center);
+    *lo = vmlal_n_s16(*lo, vget_low_s16(first), weight);
+    *lo = vmlal_n_s16(*lo, vget_low_s16(second), weight);
+    *hi = vmlal_n_s16(*hi, vget_high_s16(first), weight);
+    *hi = vmlal_n_s16(*hi, vget_high_s16(second), weight);
+}
+
+static inline __attribute__((always_inline)) void blur_horz_stripe_neon(
+    int16_t *restrict dst, const int16_t *restrict src,
+    ptrdiff_t offs, size_t src_height, size_t size, size_t step,
+    const int16_t *restrict param, int n, bool edge)
+{
+    int first = -((2 * n + STRIPE_WIDTH - 1) / STRIPE_WIDTH);
+    int16_t window[3 * STRIPE_WIDTH] __attribute__((aligned(16)));
+    int16_t *ptr = window + 2 * STRIPE_WIDTH;
+
+    for (size_t y = 0; y < src_height; y++) {
+        for (int i = first; i <= 0; i++) {
+            ptrdiff_t line_offs = offs + i * (ptrdiff_t) step;
+            const int16_t *line = edge ?
+                get_line(src, line_offs, size) : src + line_offs;
+            vst1q_s16(ptr + i * STRIPE_WIDTH, vld1q_s16(line));
+        }
+
+        const int16_t *center_ptr = ptr - n;
+        int16x8_t center = vld1q_s16(center_ptr);
+        int32x4_t lo = vdupq_n_s32(0x8000);
+        int32x4_t hi = vdupq_n_s32(0x8000);
+#if defined(__clang__)
+        // Each wrapper supplies a fixed radius, so expanding the taps
+        // removes the inner counter and repeated coefficient indexing.
+#pragma clang loop unroll(full)
+#endif
+        for (int i = n; i > 0; i--)
+            accumulate_param_pair(
+                &lo, &hi, center,
+                vld1q_s16(center_ptr - i),
+                vld1q_s16(center_ptr + i), param[i - 1]);
+
+        vst1q_s16(dst, finish_param_blur(center, lo, hi));
+        dst += STRIPE_WIDTH;
+        offs += STRIPE_WIDTH;
+    }
+}
+
+static inline __attribute__((always_inline)) void blur_horz16_neon(
+    int16_t *restrict dst, const int16_t *restrict src,
+    size_t src_width, size_t src_height,
+    const int16_t *restrict param, int n)
+{
+    ASSUME(!((uintptr_t) dst % ALIGNMENT));
+    ASSUME(!((uintptr_t) src % ALIGNMENT));
+    ASSUME(src_width > 0 && src_height > 0);
+
+    size_t dst_width = src_width + 2 * n;
+    size_t aligned_width = (src_width + STRIPE_MASK) & ~STRIPE_MASK;
+    size_t size = aligned_width * src_height;
+    size_t step = STRIPE_WIDTH * src_height;
+    size_t left_edge =
+        ((2 * n + STRIPE_WIDTH - 1) / STRIPE_WIDTH) * STRIPE_WIDTH;
+    ptrdiff_t offs = 0;
+
+    size_t x = 0;
+    for (; x < dst_width && x < left_edge; x += STRIPE_WIDTH) {
+        blur_horz_stripe_neon(
+            dst, src, offs, src_height, size, step, param, n, true);
+        dst += step;
+        offs += step;
+    }
+    for (; x < dst_width && x < aligned_width; x += STRIPE_WIDTH) {
+        blur_horz_stripe_neon(
+            dst, src, offs, src_height, size, step, param, n, false);
+        dst += step;
+        offs += step;
+    }
+    for (; x < dst_width; x += STRIPE_WIDTH) {
+        blur_horz_stripe_neon(
+            dst, src, offs, src_height, size, step, param, n, true);
+        dst += step;
+        offs += step;
+    }
+}
+
+static inline int16x8_t blur_vert_edge_line_neon(
+    const int16_t *src, ptrdiff_t center_offs, size_t step,
+    const int16_t *param, int n)
+{
+    int16x8_t center = vld1q_s16(get_line(src, center_offs, step));
+    int32x4_t lo = vdupq_n_s32(0x8000);
+    int32x4_t hi = vdupq_n_s32(0x8000);
+#if defined(__clang__)
+#pragma clang loop unroll(full)
+#endif
+    for (int i = n; i > 0; i--)
+        accumulate_param_pair(
+            &lo, &hi, center,
+            vld1q_s16(get_line(
+                src, center_offs - i * STRIPE_WIDTH, step)),
+            vld1q_s16(get_line(
+                src, center_offs + i * STRIPE_WIDTH, step)),
+            param[i - 1]);
+    return finish_param_blur(center, lo, hi);
+}
+
+static inline int16x8_t blur_vert_inner_line_neon(
+    const int16_t *center_ptr, const int16_t *param, int n)
+{
+    int16x8_t center = vld1q_s16(center_ptr);
+    int32x4_t lo = vdupq_n_s32(0x8000);
+    int32x4_t hi = vdupq_n_s32(0x8000);
+#if defined(__clang__)
+#pragma clang loop unroll(full)
+#endif
+    for (int i = n; i > 0; i--)
+        accumulate_param_pair(
+            &lo, &hi, center,
+            vld1q_s16(center_ptr - i * STRIPE_WIDTH),
+            vld1q_s16(center_ptr + i * STRIPE_WIDTH), param[i - 1]);
+    return finish_param_blur(center, lo, hi);
+}
+
+static inline __attribute__((always_inline)) void blur_vert16_neon(
+    int16_t *restrict dst, const int16_t *restrict src,
+    size_t src_width, size_t src_height,
+    const int16_t *restrict param, int n)
+{
+    ASSUME(!((uintptr_t) dst % ALIGNMENT));
+    ASSUME(!((uintptr_t) src % ALIGNMENT));
+    ASSUME(src_width > 0 && src_height > 0);
+
+    size_t dst_height = src_height + 2 * n;
+    size_t step = STRIPE_WIDTH * src_height;
+
+    for (size_t x = 0; x < src_width; x += STRIPE_WIDTH) {
+        size_t y = 0;
+        for (; y < 2 * (size_t) n; y++) {
+            ptrdiff_t center_offs = ((ptrdiff_t) y - n) * STRIPE_WIDTH;
+            vst1q_s16(dst, blur_vert_edge_line_neon(
+                src, center_offs, step, param, n));
+            dst += STRIPE_WIDTH;
+        }
+
+        // From row 2n through the final source row, every kernel tap is
+        // inside this stripe and can bypass transparent-edge selection.
+        for (; y < src_height; y++) {
+            const int16_t *center = src + (y - n) * STRIPE_WIDTH;
+            vst1q_s16(dst, blur_vert_inner_line_neon(center, param, n));
+            dst += STRIPE_WIDTH;
+        }
+
+        for (; y < dst_height; y++) {
+            ptrdiff_t center_offs = ((ptrdiff_t) y - n) * STRIPE_WIDTH;
+            vst1q_s16(dst, blur_vert_edge_line_neon(
+                src, center_offs, step, param, n));
+            dst += STRIPE_WIDTH;
+        }
+        src += step;
+    }
+}
+
+#define PARAM_BLUR_WRAPPERS(n) \
+    void ass_blur ## n ## _horz16_neon( \
+        int16_t *restrict dst, const int16_t *restrict src, \
+        size_t src_width, size_t src_height, \
+        const int16_t *restrict param) \
+    { \
+        blur_horz16_neon(dst, src, src_width, src_height, param, n); \
+    } \
+    void ass_blur ## n ## _vert16_neon( \
+        int16_t *restrict dst, const int16_t *restrict src, \
+        size_t src_width, size_t src_height, \
+        const int16_t *restrict param) \
+    { \
+        blur_vert16_neon(dst, src, src_width, src_height, param, n); \
+    }
+
+PARAM_BLUR_WRAPPERS(4)
+PARAM_BLUR_WRAPPERS(5)
+PARAM_BLUR_WRAPPERS(6)
+PARAM_BLUR_WRAPPERS(7)
+PARAM_BLUR_WRAPPERS(8)
+
 
 #undef ALIGNMENT
 #undef STRIPE_WIDTH
 #undef STRIPE_MASK
+#undef PARAM_BLUR_WRAPPERS
 
 #endif
