diff --git a/libass/c/c_blur_neon.c b/libass/c/c_blur_neon.c
index f7ab6fd5d7aa2b87b551e343d9f373c703984fc2..c9935feb9eca2f7924203f6c5dc1bc80af9cec59 100644
--- a/libass/c/c_blur_neon.c
+++ b/libass/c/c_blur_neon.c
@@ -447,9 +447,278 @@ void ass_expand_vert16_neon(int16_t *restrict dst,
