diff --git a/libass/c/c_blend_bitmaps_neon.c b/libass/c/c_blend_bitmaps_neon.c
index f096da6..7bd539b 100644
--- a/libass/c/c_blend_bitmaps_neon.c
+++ b/libass/c/c_blend_bitmaps_neon.c
@@ -79,6 +79,42 @@ void ass_imul_bitmaps_neon(uint8_t *restrict dst, ptrdiff_t dst_stride,
     }
 }
 
+void ass_mul_bitmaps_neon(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                          const uint8_t *restrict src1, ptrdiff_t src1_stride,
+                          const uint8_t *restrict src2, ptrdiff_t src2_stride,
+                          size_t width, size_t height)
+{
+    ASSUME(!((uintptr_t) dst % ALIGNMENT) && !(dst_stride % ALIGNMENT));
+    ASSUME(!(src1_stride % ALIGNMENT));
+    ASSUME(!(src2_stride % ALIGNMENT));
+    ASSUME(width > 0 && height > 0);
+
+    uint8_t *end = dst + dst_stride * height;
+    // Wide, complete blocks benefit from a 32-byte vectorization factor.
+    // Keep the compact 16-byte loop for short rows and partial blocks.
+    if (width >= 64 && !(width & 31)) {
+        while (dst < end) {
+#pragma clang loop vectorize_width(32) interleave_count(1)
+            for (size_t x = 0; x < width; x++)
+                dst[x] = (src1[x] * src2[x] + 255) >> 8;
+
+            dst += dst_stride;
+            src1 += src1_stride;
+            src2 += src2_stride;
+        }
+        return;
+    }
+
+    while (dst < end) {
+        for (size_t x = 0; x < width; x++)
+            dst[x] = (src1[x] * src2[x] + 255) >> 8;
+
+        dst += dst_stride;
+        src1 += src1_stride;
+        src2 += src2_stride;
+    }
+}
+
 
 #undef ALIGNMENT
 #undef BLOCK_SIZE
