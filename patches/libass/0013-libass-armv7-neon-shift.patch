diff --git a/libass/c/c_shift.c b/libass/c/c_shift.c
index 166267e..2a0a033 100644
--- a/libass/c/c_shift.c
+++ b/libass/c/c_shift.c
@@ -23,6 +23,10 @@
 #include <stddef.h>
 #include <stdint.h>
 
+#if defined(__arm__) && defined(__ARM_NEON)
+#include <arm_neon.h>
+#endif
+
 
 #define ALIGNMENT  16
 
@@ -56,3 +60,76 @@ void ass_shift_c(uint8_t *restrict buf, ptrdiff_t stride,
     int16_t tmp1 = 64 * buf[width - 1] - buf[width - 1] * (int16_t) shift_x;
     buf[width - 1] = (int16_t) (tmp1 - (int16_t) ((int16_t) (2 * tmp1) * (int32_t) sy >> 16) + 32) >> 6;
 }
+
+#if defined(__arm__) && defined(__ARM_NEON)
+static inline int16x8_t shift_x_neon(const uint8_t *src, int16_t shift_x)
+{
+    uint8x8_t left = vld1_u8(src);
+    uint8x8_t right = vld1_u8(src + 1);
+    int16x8_t left16 = vreinterpretq_s16_u16(vmovl_u8(left));
+    int16x8_t delta = vreinterpretq_s16_u16(vsubl_u8(left, right));
+    return vsubq_s16(vshlq_n_s16(left16, 6), vmulq_n_s16(delta, shift_x));
+}
+
+static inline uint8x8_t shift_y_neon(int16x8_t upper, int16x8_t lower, int16_t shift_y)
+{
+    int16x8_t delta = vsubq_s16(upper, lower);
+    int16x8_t correction = vqdmulhq_n_s16(delta, shift_y);
+    return vqrshrun_n_s16(vsubq_s16(upper, correction), 6);
+}
+
+static inline uint8_t shift_pixel(
+    uint8_t upper_left,
+    uint8_t upper_right,
+    uint8_t lower_left,
+    uint8_t lower_right,
+    int16_t shift_x,
+    int16_t shift_y
+) {
+    int16_t upper = 64 * upper_left - (upper_left - upper_right) * shift_x;
+    int16_t lower = 64 * lower_left - (lower_left - lower_right) * shift_x;
+    int16_t correction = (int16_t) (
+        (int16_t) (2 * (upper - lower)) * (int32_t) shift_y >> 16
+    );
+    return (uint8_t) ((upper - correction + 32) >> 6);
+}
+
+void ass_shift_neon(uint8_t *restrict buf, ptrdiff_t stride,
+                    size_t width, size_t height, int shift_x, int shift_y)
+{
+    ASSUME(!((uintptr_t) buf % ALIGNMENT) && !(stride % ALIGNMENT));
+    ASSUME(!(shift_x & ~63) && !(shift_y & ~63));
+    ASSUME(width > 1 && height > 1);
+
+    int16_t sx = shift_x;
+    int16_t sy = shift_y << 9;
+    for (size_t y = 1; y < height; y++) {
+        uint8_t *next = buf + stride;
+        size_t x = 0;
+        for (; x + 8 < width; x += 8) {
+            int16x8_t upper = shift_x_neon(buf + x, sx);
+            int16x8_t lower = shift_x_neon(next + x, sx);
+            vst1_u8(buf + x, shift_y_neon(upper, lower, sy));
+        }
+        for (; x + 1 < width; x++) {
+            buf[x] = shift_pixel(
+                buf[x], buf[x + 1], next[x], next[x + 1], sx, sy
+            );
+        }
+        buf[width - 1] = shift_pixel(
+            buf[width - 1], 0, next[width - 1], 0, sx, sy
+        );
+        buf = next;
+    }
+
+    size_t x = 0;
+    int16x8_t zero = vdupq_n_s16(0);
+    for (; x + 8 < width; x += 8) {
+        int16x8_t upper = shift_x_neon(buf + x, sx);
+        vst1_u8(buf + x, shift_y_neon(upper, zero, sy));
+    }
+    for (; x + 1 < width; x++)
+        buf[x] = shift_pixel(buf[x], buf[x + 1], 0, 0, sx, sy);
+    buf[width - 1] = shift_pixel(buf[width - 1], 0, 0, 0, sx, sy);
+}
+#endif
