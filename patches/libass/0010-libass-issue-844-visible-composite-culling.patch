--- a/libass/ass_render.c
+++ b/libass/ass_render.c
@@ -2724,6 +2724,35 @@ static double restore_blur(int qblur)
     return sigma * sigma;
 }
 
+static inline int subpixel_abs_ceil(int32_t x)
+{
+    int64_t abs_x = x < 0 ? -(int64_t) x : x;
+    return (int) ((abs_x + 63) >> 6);
+}
+
+static bool bitmap_may_hit_frame(const Bitmap *bm, ASS_Vector pos,
+                                 const FilterDesc *filter,
+                                 int frame_w, int frame_h)
+{
+    if (!bm || !bm->buffer || frame_w <= 0 || frame_h <= 0)
+        return false;
+
+    int64_t xpad = ass_blur_padding(restore_blur(filter->blur_x)) +
+        ass_be_padding(filter->be);
+    int64_t ypad = ass_blur_padding(restore_blur(filter->blur_y)) +
+        ass_be_padding(filter->be);
+    if (filter->flags & FILTER_NONZERO_SHADOW) {
+        xpad += subpixel_abs_ceil(filter->shadow.x);
+        ypad += subpixel_abs_ceil(filter->shadow.y);
+    }
+
+    int64_t left = pos.x + bm->left - xpad;
+    int64_t top = pos.y + bm->top - ypad;
+    int64_t right = pos.x + bm->left + bm->w + xpad;
+    int64_t bottom = pos.y + bm->top + bm->h + ypad;
+    return left < frame_w && right > 0 && top < frame_h && bottom > 0;
+}
