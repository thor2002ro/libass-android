diff --git a/libass/c/c_be_blur_neon.c b/libass/c/c_be_blur_neon.c
new file mode 100644
index 0000000000000000000000000000000000000000..a861ab031340a9c1c4af88cdc938e49bfe1a536f
--- /dev/null
+++ b/libass/c/c_be_blur_neon.c
@@ -0,0 +1,102 @@
+#include "config.h"
+
+#if defined(__arm__) && defined(__ARM_NEON)
+
+#include "ass_compat.h"
+#include "ass_utils.h"
+
+#include <arm_neon.h>
+#include <stddef.h>
+#include <stdint.h>
+
+
+#define ALIGNMENT 16
+#define BLOCK_SIZE 8
+
+
+static inline uint16_t horizontal_pixel(const uint8_t *src,
+                                        size_t x, size_t width)
+{
+    uint16_t left = x ? src[x - 1] : 0;
+    uint16_t right = x + 1 < width ? src[x + 1] : 0;
+    return left + 2 * src[x] + right;
+}
+
+static inline uint16x8_t horizontal_block(const uint8_t *src,
+                                          size_t x, size_t width)
+{
+    uint8x8_t zero = vdup_n_u8(0);
+    uint8x8_t center = vld1_u8(src + x);
+    uint8x8_t left = x ? vld1_u8(src + x - 1) :
+                         vext_u8(zero, center, BLOCK_SIZE - 1);
+    uint8x8_t right = x + BLOCK_SIZE < width ?
+        vld1_u8(src + x + 1) : vext_u8(center, zero, 1);
+    uint16x8_t value = vaddl_u8(left, right);
+    return vaddq_u16(value, vshlq_n_u16(vmovl_u8(center), 1));
+}
+
+void ass_be_blur_neon(uint8_t *restrict buf, ptrdiff_t stride,
+                      size_t width, size_t height, uint16_t *restrict tmp)
+{
+    ASSUME(!((uintptr_t) buf % ALIGNMENT) && !(stride % ALIGNMENT));
+    ASSUME(!((uintptr_t) tmp % ALIGNMENT));
+    ASSUME(width > 1 && height > 1);
+
+    uint16_t *col_pix = tmp;
+    uint16_t *col_sum = tmp + stride;
+    size_t vector_width = width & ~(BLOCK_SIZE - 1);
+
+    // Seed both history rows with the horizontally blurred first row.
+    size_t x = 0;
+    for (; x < vector_width; x += BLOCK_SIZE) {
+        uint16x8_t horizontal = horizontal_block(buf, x, width);
+        vst1q_u16(col_pix + x, horizontal);
+        vst1q_u16(col_sum + x, horizontal);
+    }
+    for (; x < width; x++) {
+        uint16_t horizontal = horizontal_pixel(buf, x, width);
+        col_pix[x] = col_sum[x] = horizontal;
+    }
+
+    for (size_t y = 1; y < height; y++) {
+        uint8_t *dst = buf;
+        buf += stride;
+
+        // col_pix holds the previous horizontal row; col_sum holds the
+        // previous vertical pair. Updating both produces the completed row.
+        x = 0;
+        for (; x < vector_width; x += BLOCK_SIZE) {
+            uint16x8_t horizontal = horizontal_block(buf, x, width);
+            uint16x8_t vertical = vaddq_u16(vld1q_u16(col_pix + x),
+                                            horizontal);
+            uint16x8_t output = vaddq_u16(vld1q_u16(col_sum + x),
+                                          vertical);
+            vst1_u8(dst + x, vshrn_n_u16(output, 4));
+            vst1q_u16(col_pix + x, horizontal);
+            vst1q_u16(col_sum + x, vertical);
+        }
+        for (; x < width; x++) {
+            uint16_t horizontal = horizontal_pixel(buf, x, width);
+            uint16_t vertical = col_pix[x] + horizontal;
+            dst[x] = (col_sum[x] + vertical) >> 4;
+            col_pix[x] = horizontal;
+            col_sum[x] = vertical;
+        }
+    }
+
+    // The bottom edge repeats the last horizontal row in the final sum.
+    x = 0;
+    for (; x < vector_width; x += BLOCK_SIZE) {
+        uint16x8_t output = vaddq_u16(vld1q_u16(col_sum + x),
+                                      vld1q_u16(col_pix + x));
+        vst1_u8(buf + x, vshrn_n_u16(output, 4));
+    }
+    for (; x < width; x++)
+        buf[x] = (col_sum[x] + col_pix[x]) >> 4;
+}
+
+
+#undef ALIGNMENT
+#undef BLOCK_SIZE
+
+#endif
