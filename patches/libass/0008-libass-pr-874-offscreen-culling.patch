diff --git a/libass/ass_offscreen.h b/libass/ass_offscreen.h
new file mode 100644
index 0000000000000000000000000000000000000000..6e171741fc6d5942d4544719475fc35ca2e1636a
--- /dev/null
+++ b/libass/ass_offscreen.h
@@ -0,0 +1,54 @@
+#ifndef LIBASS_OFFSCREEN_H
+#define LIBASS_OFFSCREEN_H
+
+#include <limits.h>
+#include <stdint.h>
+
+typedef enum {
+    ASS_BITMAP_KEEP_FULL,
+    ASS_BITMAP_CLIP_PARTIAL,
+    ASS_BITMAP_CULL,
+} ASS_BitmapClipDecision;
+
+static inline ASS_BitmapClipDecision ass_bitmap_clip_decision(
+    int64_t width, int64_t height,
+    int64_t visible_width, int64_t visible_height)
+{
+    if (visible_width <= 0 || visible_height <= 0)
+        return ASS_BITMAP_CULL;
+    if (width <= 0 || height <= 0 ||
+            (visible_width >= width && visible_height >= height))
+        return ASS_BITMAP_KEEP_FULL;
+
+    uint64_t full_area = (uint64_t) width * (uint64_t) height;
+    uint64_t visible_area =
+        (uint64_t) visible_width * (uint64_t) visible_height;
+    uint64_t saved_area = full_area - visible_area;
+    uint64_t quarter_area = full_area / 4 + (full_area % 4 != 0);
+
+    if (full_area > 256 * 256 && saved_area >= 128 * 128 &&
+            saved_area >= quarter_area)
+        return ASS_BITMAP_CLIP_PARTIAL;
+    return ASS_BITMAP_KEEP_FULL;
+}
+
+static inline int32_t ass_clamp_clip_coord(int64_t value)
+{
+    if (value < INT32_MIN)
+        return INT32_MIN;
+    if (value > INT32_MAX)
+        return INT32_MAX;
+    return value;
+}
+
+static inline void ass_expand_clip_axis(int32_t *min, int32_t *max,
+                                        uint32_t pad, int32_t shadow)
+{
+    int64_t shadow_before = shadow > 0 ? ((int64_t) shadow + 63) >> 6 : 0;
+    int64_t shadow_after = shadow < 0 ? (-(int64_t) shadow + 63) >> 6 : 0;
+
+    *min = ass_clamp_clip_coord((int64_t) *min - pad - shadow_before);
+    *max = ass_clamp_clip_coord((int64_t) *max + pad + shadow_after);
+}
+
+#endif
