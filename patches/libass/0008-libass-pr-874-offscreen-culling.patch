+#include "ass_offscreen.h"
+
+#include <limits.h>
+#include <stdio.h>
+
+static int check_decision(const char *name,
+                          ASS_BitmapClipDecision actual,
+                          ASS_BitmapClipDecision expected)
+{
+    if (actual == expected)
+        return 0;
+
+    fprintf(stderr, "%s: got %d, expected %d\n", name, actual, expected);
+    return 1;
+}
+
+int main(void)
+{
+    int failed = 0;
+
+    failed += check_decision(
+        "fully invisible bitmap",
+        ass_bitmap_clip_decision(2048, 1024, 0, 1024),
+        ASS_BITMAP_CULL);
+    failed += check_decision(
+        "ordinary scrolling glyph",
+        ass_bitmap_clip_decision(64, 64, 16, 64),
+        ASS_BITMAP_KEEP_FULL);
+    failed += check_decision(
+        "bitmap at size threshold",
+        ass_bitmap_clip_decision(256, 256, 128, 256),
+        ASS_BITMAP_KEEP_FULL);
+    failed += check_decision(
+        "large bitmap with small offscreen portion",
+        ass_bitmap_clip_decision(512, 512, 448, 512),
+        ASS_BITMAP_KEEP_FULL);
+    failed += check_decision(
+        "large bitmap with meaningful offscreen portion",
+        ass_bitmap_clip_decision(512, 512, 384, 512),
+        ASS_BITMAP_CLIP_PARTIAL);
+    failed += check_decision(
+        "oversized mostly offscreen bitmap",
+        ass_bitmap_clip_decision(4096, 2048, 512, 2048),
+        ASS_BITMAP_CLIP_PARTIAL);
+    failed += check_decision(
+        "fully visible large bitmap",
+        ass_bitmap_clip_decision(1024, 1024, 1024, 1024),
+        ASS_BITMAP_KEEP_FULL);
+    failed += check_decision(
+        "largest transformed bounds do not overflow",
+        ass_bitmap_clip_decision(UINT32_MAX, UINT32_MAX,
+                                 UINT32_MAX, UINT32_MAX / 2),
+        ASS_BITMAP_CLIP_PARTIAL);
+
+    int32_t min = -100, max = 100;
+    ass_expand_clip_axis(&min, &max, 20, 65);
+    if (min != -122 || max != 120) {
+        fprintf(stderr, "positive shadow expansion: got [%d, %d]\n", min, max);
+        failed++;
+    }
+
+    min = -100;
+    max = 100;
+    ass_expand_clip_axis(&min, &max, 20, -64);
+    if (min != -120 || max != 121) {
+        fprintf(stderr, "negative shadow expansion: got [%d, %d]\n", min, max);
+        failed++;
+    }
+
+    min = INT32_MIN + 10;
+    max = INT32_MAX - 10;
+    ass_expand_clip_axis(&min, &max, 20, INT32_MIN);
+    if (min != INT32_MIN || max != INT32_MAX) {
+        fprintf(stderr, "saturating expansion: got [%d, %d]\n", min, max);
+        failed++;
+    }
+
+    return failed != 0;
+}
