+static int blur_offset(const BlurMethod *blur)
+{
+    return ((2 * blur->radius + 9) << blur->level) - 5;
+}
+
+static uint32_t blurred_dim(uint32_t d, const BlurMethod *blur)
+{
+    return ((d + blur_offset(blur)) & ~((1 << blur->level) - 1)) - 4;
+}
