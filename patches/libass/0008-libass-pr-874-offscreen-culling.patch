+static void find_best_method(BlurMethod *blur, double r2)
+{
+    find_scale(blur, r2);
+
+    double mu[8];
+    if (r2 < 0.5) {
+        mu[1] = 0.085 * r2 * r2 * r2;
+        mu[0] = 0.5 * r2 - 4 * mu[1];
+        mu[2] = mu[3] = 0;
