     *rn = vrhaddq_u16(vhaddq_u16(value, n1), z0);
 }
 
+static inline uint16x8_t unpack8(uint8x8_t pixels)
+{
+    uint16x8_t value = vmovl_u8(pixels);
+    value = vorrq_u16(value, vshlq_n_u16(value, 8));
+    return vrshrq_n_u16(value, 2);
+}
+
+void ass_stripe_unpack16_neon(int16_t *restrict dst,
+                               const uint8_t *restrict src,
+                               ptrdiff_t src_stride,
+                               size_t width, size_t height)
+{
+    ASSUME(!((uintptr_t) dst % ALIGNMENT));
+    ASSUME(!((uintptr_t) src % ALIGNMENT) && !(src_stride % ALIGNMENT));
+    ASSUME(width > 0 && height > 0);
+
+    size_t rounded_width = (width + STRIPE_MASK) & ~STRIPE_MASK;
+    size_t step = STRIPE_WIDTH * height;
+
+    size_t y = 0;
+    // Consecutive rows occupy adjacent eight-element slices in each stripe.
+    // Walking two rows together shares the stripe and loop-control work.
+    for (; y + 1 < height; y += 2) {
+        int16_t *ptr = dst;
+        size_t x = 0;
+
+        for (; x + 2 * STRIPE_WIDTH <= rounded_width;
+             x += 2 * STRIPE_WIDTH) {
+            uint8x16_t pixels0 = vld1q_u8(src + x);
+            uint8x16_t pixels1 = vld1q_u8(src + src_stride + x);
+            // The regular bitmap keeps adjacent pixels together, while the
+            // blur buffer separates each eight-pixel stripe by its height.
+            vst1q_s16(ptr, vreinterpretq_s16_u16(
+                unpack8(vget_low_u8(pixels0))));
+            vst1q_s16(ptr + STRIPE_WIDTH, vreinterpretq_s16_u16(
+                unpack8(vget_low_u8(pixels1))));
+            ptr += step;
+            vst1q_s16(ptr, vreinterpretq_s16_u16(
+                unpack8(vget_high_u8(pixels0))));
+            vst1q_s16(ptr + STRIPE_WIDTH, vreinterpretq_s16_u16(
+                unpack8(vget_high_u8(pixels1))));
+            ptr += step;
+        }
+
+        if (x < rounded_width) {
+            vst1q_s16(ptr, vreinterpretq_s16_u16(
+                unpack8(vld1_u8(src + x))));
+            vst1q_s16(ptr + STRIPE_WIDTH, vreinterpretq_s16_u16(
+                unpack8(vld1_u8(src + src_stride + x))));
+        }
+
+        dst += 2 * STRIPE_WIDTH;
+        src += 2 * src_stride;
+    }
+
+    if (y < height) {
+        int16_t *ptr = dst;
+        size_t x = 0;
+
+        for (; x + 2 * STRIPE_WIDTH <= rounded_width;
+             x += 2 * STRIPE_WIDTH) {
+            uint8x16_t pixels = vld1q_u8(src + x);
+            vst1q_s16(ptr, vreinterpretq_s16_u16(
+                unpack8(vget_low_u8(pixels))));
+            ptr += step;
+            vst1q_s16(ptr, vreinterpretq_s16_u16(
+                unpack8(vget_high_u8(pixels))));
+            ptr += step;
+        }
+
+        if (x < rounded_width)
+            vst1q_s16(ptr, vreinterpretq_s16_u16(
+                unpack8(vld1_u8(src + x))));
+    }
+}
