+
+void ass_cache_client_set_clear(CacheClientSet *set)
+{
+    CacheClient *client = set->first_client;
+
+    while (client) {
+        CacheClient *next = client->next;
+        cache_client_done(client);
+        client = next;
+    }
+
+    set->first_client = NULL;
