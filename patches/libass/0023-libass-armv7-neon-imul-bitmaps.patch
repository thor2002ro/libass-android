 }
 
+void ass_imul_bitmaps_neon(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                           const uint8_t *restrict src, ptrdiff_t src_stride,
+                           size_t width, size_t height)
+{
+    ASSUME(!(dst_stride % ALIGNMENT));
+    ASSUME(!(src_stride % ALIGNMENT));
+    ASSUME(width > 0 && height > 0);
+
+    const size_t tail_width = width & (BLOCK_SIZE - 1);
+    const size_t full_width = width - tail_width;
+    const uint16x8_t rounding = vdupq_n_u16(255);
+    for (size_t y = 0; y < height; y++) {
+        size_t x = 0;
+        for (; x + 32 <= full_width; x += 32) {
+            uint8x16_t d0 = vld1q_u8(dst + x);
+            uint8x16_t d1 = vld1q_u8(dst + x + 16);
+            uint8x16_t s0 = vmvnq_u8(vld1q_u8(src + x));
+            uint8x16_t s1 = vmvnq_u8(vld1q_u8(src + x + 16));
+            uint16x8_t p0 = vmull_u8(vget_low_u8(d0), vget_low_u8(s0));
+            uint16x8_t p1 = vmull_u8(vget_high_u8(d0), vget_high_u8(s0));
+            uint16x8_t p2 = vmull_u8(vget_low_u8(d1), vget_low_u8(s1));
+            uint16x8_t p3 = vmull_u8(vget_high_u8(d1), vget_high_u8(s1));
+            vst1q_u8(dst + x, vcombine_u8(vaddhn_u16(p0, rounding),
+                                         vaddhn_u16(p1, rounding)));
+            vst1q_u8(dst + x + 16, vcombine_u8(vaddhn_u16(p2, rounding),
+                                              vaddhn_u16(p3, rounding)));
+        }
+        for (; x < full_width; x += BLOCK_SIZE) {
+            uint8x16_t dst_value = vld1q_u8(dst + x);
+            uint8x16_t inverse = vmvnq_u8(vld1q_u8(src + x));
+            uint16x8_t lo = vmull_u8(
+                                     vget_low_u8(dst_value),
+                                     vget_low_u8(inverse));
+            uint16x8_t hi = vmull_u8(
+                                     vget_high_u8(dst_value),
+                                     vget_high_u8(inverse));
+            vst1q_u8(dst + x, vcombine_u8(vaddhn_u16(lo, rounding),
+                                          vaddhn_u16(hi, rounding)));
+        }
+        for (size_t i = 0; i < tail_width; i++, x++)
+            dst[x] = (dst[x] * (255 - src[x]) + 255) >> 8;
+
+        dst += dst_stride;
+        src += src_stride;
+    }
+}
+
 
 #undef ALIGNMENT
 #undef BLOCK_SIZE
