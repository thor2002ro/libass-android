@@ -21,6 +21,20 @@
     (((int32_t) ((c) >> (7 + TILE_ORDER)) * (int64_t) (scale) + ((int64_t) 1 << 44)) >> 45)
 
 
+void ass_fill_solid_tile16_neon(uint8_t *buf, ptrdiff_t stride, int set)
+{
+    ASSUME(!((uintptr_t) buf % ALIGNMENT) && !(stride % ALIGNMENT));
+
+    uint8x16_t value = vdupq_n_u8(set ? 255 : 0);
+    for (int y = 0; y < TILE_SIZE; y++) {
+        // A 16-pixel tile row is exactly one NEON vector. Advancing by
+        // stride leaves any padding after the row unchanged.
+        vst1q_u8(buf, value);
+        buf += stride;
+    }
+}
