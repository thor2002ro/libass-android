+void ass_merge_tile16_neon(uint8_t *restrict buf, ptrdiff_t stride,
+                           const uint8_t *restrict tile)
+{
+    ASSUME(!((uintptr_t) buf % ALIGNMENT) && !(stride % ALIGNMENT));
+
+    for (int y = 0; y < TILE_SIZE; y++) {
+        // Each tile row is one vector, and unsigned maximum implements the
+        // coverage union without touching destination stride padding.
+        uint8x16_t merged = vmaxq_u8(vld1q_u8(buf), vld1q_u8(tile));
+        vst1q_u8(buf, merged);
+        buf += stride;
+        tile += TILE_SIZE;
+    }
+}
